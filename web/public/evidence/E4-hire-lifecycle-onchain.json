  "recoveredAtUtc": "2026-09-06T11:05:47.657Z",
  "readOnly": "eth_getLogs, eth_getTransactionByHash, eth_getTransactionReceipt, eth_getBlockByNumber, web3_sha3 only.",
  "chainId": 97,
  "commerceContract": "0xa206c0517B6371C6638CD9e4a42Cc9f02A33B0DE",
  "scanWindow": {
